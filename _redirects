# Cloudflare Pages _redirects
# 所有语言路径重写到根目录文件（200 = rewrite，不跳转）
# JS 根据 URL 路径加载对应语言包

# /api/health 平台报错，统一重定向到 /api/status（外部监控用）
/api/health /api/status 302
# 旧样式路径重定向 — 修复 /styles/main.css 404
/styles/main.css /styles/premium.css 301

# 城市页面：/city/slug/ → /city/slug.html（美化URL）
/city/* /city/:splat.html 200
/city/*/ /city/:splat.html 200

/en/*  /:splat  200
/zh/*  /:splat  200
/de/*  /:splat  200
/fr/*  /:splat  200
/es/*  /:splat  200
/ja/*  /:splat  200
/ko/*  /:splat  200
/pt/*  /:splat  200
/ar/*  /:splat  200

# 重复页面合并301重定向
/privacy-policy.html /privacy.html 301
/api-guide.html /api.html 301

# 短链跳转
/time/beijing /city/beijing/ 301

# 多语言路径重定向
/zh/privacy-policy.html /zh/privacy.html 301
/de/privacy-policy.html /de/privacy.html 301

# ============================================================
# GlobeTimeZone - Cloudflare Pages Headers Configuration
# v3.1 | 2026-06-13 — CSP精简版（CF header限制8KB）
# ============================================================

# === 全局安全头（所有页面） ===
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://js.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.sentry.io https://*.firebaseio.com https://securetoken.googleapis.com https://firebaseinstallations.googleapis.com; font-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; worker-src 'self' blob:
  Cache-Control: public, max-age=14400, stale-while-revalidate=86400
  Vary: Accept-Encoding

# === OG图：强缓存30天 ===
/og/*
  Cache-Control: public, max-age=86400, s-maxage=2592000, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  Vary: Accept-Encoding

# === CSS 文件：1年缓存 ===
/css/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

# === JS 文件：1年缓存 ===
/js/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

# === 图标：30天缓存 ===
/icons/*
  Cache-Control: public, max-age=2592000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000, immutable

# === manifest / service worker ===
/manifest.json
  Cache-Control: public, max-age=86400, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, max-age=0, must-revalidate

# === robots.txt / sitemap ===
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

# === i18n 语言包：4小时缓存 ===
/locales/*
  Cache-Control: public, max-age=3600, must-revalidate

# === API 端点：不缓存 ===
/api/*
  Cache-Control: no-cache, no-store, max-age=0

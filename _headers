# ============================================================
# GlobeTimeZone - Cloudflare Pages Headers Configuration
# v6.0 | 2026-06-14 — 工业级重构版：与中间件安全头标准完全一致
# 规则：/* 全局安全头，按路径分组缓存策略
# ============================================================

# === 全局安全头（所有页面，不含 Cache-Control） ===
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 0
  X-Download-Options: noopen
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Origin-Agent-Cluster: ?1

# === HTML 页面：边缘5分钟缓存 ===
/*.html
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400

# === 首页 ===
/
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400

# === 目录型 HTML 页面（不带 .html 后缀）边缘5分钟缓存 ===
/time-difference/*
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400
/pricing/*
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400
/tools/*
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400
/team-clock/*
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400
/widget/*
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400
/meeting-planner/*
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400
/privacy/*
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400
/blog/*
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400

# === 404页面：禁止索引 ===
# 屏蔽规则（_redirects）统一 302 到 /404 —— 因为 CF 的 html_handling 会把
#   /404.html 再 308 跳到 /404，直接指向 /404 可省掉 302→308→200 的一跳。
#   两个路径都标注，避免任一形态被收录。
/404.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/404
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# === OG图：强缓存30天 ===
/og/*
  Cache-Control: public, max-age=86400, s-maxage=2592000, stale-while-revalidate=86400

# === CSS 文件：1年缓存 ===
/css/*
  Cache-Control: public, max-age=31536000, immutable

/styles/*
  Cache-Control: public, max-age=31536000, immutable

# === JS 文件：1年缓存 ===
/js/*
  Cache-Control: public, max-age=31536000, immutable

/scripts/*
  Cache-Control: public, max-age=31536000, immutable

# === 静态资源：1年不可变缓存 ===
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# === 图标：30天缓存 ===
/icons/*
  Cache-Control: public, max-age=2592000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000, immutable

/favicon.svg
  Cache-Control: public, max-age=2592000, immutable

/favicon.ico
  Cache-Control: public, max-age=2592000, immutable

/og-default.png
  Cache-Control: public, max-age=2592000, immutable

# === manifest：1天+must-revalidate ===
/manifest.json
  Cache-Control: public, max-age=86400, must-revalidate

# === service worker：绝不缓存 ===
/sw.js
  Cache-Control: no-cache, no-store, max-age=0, must-revalidate

# === robots.txt / sitemap ===
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml

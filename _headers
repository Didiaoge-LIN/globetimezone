# ============================================================
# GlobeTimeZone - Cloudflare Pages Headers Configuration
# 安全加固手册 v2.0 | 2026-05-25
# ============================================================

# === 全局安全头（所有页面） ===
# HSTS(1年+子域名+预加载), X-Content-Type-Options, X-Frame-Options,
# Referrer-Policy, Permissions-Policy, Content-Security-Policy
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com https://www.google-analytics.com https://www.gstatic.com https://*.firebaseio.com https://*.googleapis.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com https://www.google-analytics.com https://www.gstatic.com https://*.sentry.io https://*.cloudflareinsights.com; frame-src https://*.firebaseapp.com; font-src 'self' https://cdn.jsdelivr.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; report-uri /csp-report;

# === 可嵌入微件（允许被第三方 iframe 嵌入） ===
/widget/*
  X-Frame-Options: ALLOW
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-ancestors *; base-uri 'self'; form-action 'self';

# === HTML 页面：1小时缓存，允许重新验证 ===
/*.html
  Cache-Control: public, max-age=3600, must-revalidate
  Vary: Accept-Encoding, Accept-Language

# === CSS 文件：1年缓存 ===
# NOTE: immutable removed to prevent permanent caching of error responses
/css/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

# === JS 文件：1年缓存 ===
# NOTE: immutable removed to prevent permanent caching of error responses
/js/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

# === 图标：30天缓存 ===
/icons/*
  Cache-Control: public, max-age=2592000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000, immutable

# === manifest / service worker：1天缓存 ===
/manifest.json
  Cache-Control: public, max-age=86400, must-revalidate

/sw.js
  Cache-Control: public, max-age=86400, must-revalidate

# === robots.txt / sitemap：1天缓存 ===
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

# === API 端点：不缓存 ===
/api/*
  Cache-Control: no-cache, no-store, max-age=0
